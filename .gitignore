# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Ignore test reports
*report.xml

# Go workspace file
go.work
go.work.sum

# env files
.env
.env.local

# build output (root binary; do not match cmd/mcpcheck/)
/mcpcheck
.claude/

# tests/servers corpus build artifacts (see tests/servers/setup.sh)
tests/servers/**/.venv/
tests/servers/**/node_modules/
tests/servers/**/target/
tests/servers/**/bin/
__pycache__/
